{
  "name": "@akaak/yant",
  "version": "1.0.0",
  "description": "Yet Another Note Tool — a terminal REPL for meeting notes with screenshots and AI summaries",
  "type": "module",
  "bin": {
    "yant": "app.mjs"
  },
  "scripts": {
    "prepare": "esbuild index.js --bundle --packages=external --platform=node --jsx=automatic --loader:.js=jsx --format=esm --outfile=app.mjs && chmod +x app.mjs",
    "start": "npm run prepare && node app.mjs",
    "dev": "esbuild index.js --bundle --packages=external --platform=node --jsx=automatic --loader:.js=jsx --format=esm --outfile=app.mjs && node --watch app.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "chalk": "^5.3.0",
    "date-fns": "^3.6.0",
    "ink": "^5.0.1",
    "ink-text-input": "^6.0.0",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "esbuild": "^0.27.4"
  },
  "author": "Kiran (AK) Adapa",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akaak/yant.git"
  },
  "keywords": [
    "meeting",
    "notes",
    "cli",
    "ai",
    "terminal",
    "anthropic"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
