{
  "name": "meeting-notes",
  "version": "1.0.0",
  "description": "Claude Code-style terminal app for meeting notes",
  "main": "index.js",
  "type": "module",
  "bin": {
    "notes": "./index.js"
  },
  "scripts": {
    "start": "esbuild index.js --bundle --packages=external --platform=node --jsx=automatic --loader:.js=jsx --format=esm --outfile=.app.mjs && node .app.mjs",
    "dev": "esbuild index.js --bundle --packages=external --platform=node --jsx=automatic --loader:.js=jsx --format=esm --outfile=.app.mjs && node --watch .app.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "chalk": "^5.3.0",
    "date-fns": "^3.6.0",
    "ink": "^5.0.1",
    "ink-text-input": "^6.0.0",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "esbuild": "^0.27.4"
  }
}
